# ── LLM (Ollama) ──────────────────────────────────────────────
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenStreetMap / Overpass ──────────────────────────────────
USER_AGENT=OSMAgenticAI/1.0 (your_email@example.com)
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Database (SQLite) ─────────────────────────────────────────
DATABASE_PATH=data/leads.db

# ── Google Sheets (optional export) ───────────────────────────
# Set ENABLE_SHEETS_EXPORT=true only if credentials.json is configured.
ENABLE_SHEETS_EXPORT=false
SPREADSHEET_ID=your_google_sheet_id_here

# ── Pinecone (Levels 3+ — persistent vector dedup) ────────────
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_INDEX=osm-leads
# PINECONE_ENVIRONMENT=us-east-1

# ── API auth (Level 18) ───────────────────────────────────────
# API_KEY=your_secret_api_key
